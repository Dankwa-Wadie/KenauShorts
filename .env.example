# KenauShorts Environment Configuration
# Copy this file to .env or configure keys directly via the KenauShorts Studio Web Interface.

# AI Editorial Providers (At least one is required)
# Recommended: Gemini (Generous free tier) or Claude
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# YouTube Data API v3 Key (Used for license and video metadata checks)
YOUTUBE_API_KEY=""

# Reddit API Credentials (Optional - public JSON scraping works without them, but API credentials provide higher rate limits)
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Port for local Studio Web Interface (Default: 8766)
KENAU_STUDIO_PORT=8766
